# ===== Discord BOT tokens: stored by Go Gateway only. =====
P1228_GENERAL_BOT_TOKEN=
P1228_READ_ALOUD_A_BOT_TOKEN=
P1228_READ_ALOUD_B_BOT_TOKEN=

# ===== Unique worker secrets. Each secret must exist in Gateway and its matching Worker env. =====
P1228_GENERAL_WORKER_SECRET=
P1228_READ_ALOUD_A_WORKER_SECRET=
P1228_READ_ALOUD_B_WORKER_SECRET=

# ===== Worker runtime =====
P1228_GATEWAY_URL=http://127.0.0.1:8787
P1228_WORKER_ID=general
P1228_BOT_ID=general
P1228_WORKER_SECRET=

# ===== Voice synthesis endpoint (VOICEVOX ENGINE-compatible HTTP API) =====
P1228_AUDIO_ENGINE_URL=http://127.0.0.1:50021
P1228_AUDIO_CACHE_DIR=./data/audio-cache
P1228_AUDIO_CACHE_MAX_MB=512
P1228_AUDIO_CACHE_TTL_HOURS=24

# ===== Optional alert destination. Do not commit a real webhook URL. =====
P1228_ALERT_WEBHOOK_URL=

# ===== Public Discord Application IDs (must match config/gateway.yaml) =====
# ===== sync-commands uses these per-BOT variables on a direct run; the deploy =====
# ===== scripts instead pass a unified P1228_APPLICATION_ID per Worker env file. =====
P1228_GENERAL_APPLICATION_ID=
P1228_READ_ALOUD_A_APPLICATION_ID=
P1228_READ_ALOUD_B_APPLICATION_ID=
